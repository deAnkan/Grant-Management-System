<%- include('../partials/shell-start',{title:'Admin Application Detail',navItems:[
{label:'Dashboard',icon:'layout-dashboard',href:'/admin/dashboard'},{label:'Applications',icon:'files',href:'/admin/applications',active:true},{label:'Reviewers',icon:'users-round',href:'/admin/reviewers'},{label:'Projects',icon:'folder-kanban',href:'/admin/projects'}],user,institutionName:'University Grant Office'}) %>
<%- include('../partials/breadcrumbs',{items:[{label:'Administration',href:'/admin/dashboard'},{label:'Applications',href:'/admin/applications'},{label:'Detail'}]}) %>
<div class="page-head">
  <div>
    <div class="eyebrow" id="admin-detail-eyebrow">Loading application...</div>
    <h1 id="admin-detail-title">Loading proposal...</h1>
    <p id="admin-detail-meta">Please wait...</p>
  </div>
  <div id="admin-detail-status-container"></div>
</div>
<div class="grid grid-2">
  <div class="grid" style="align-content:start">
    <div class="card">
      <div class="section-title"><h3>Application summary</h3></div>
      <div class="card-pad">
        <p id="admin-detail-synopsis" class="small muted">Loading synopsis...</p>
        <div class="grid grid-2" style="margin-top:16px">
          <div><div class="eyebrow">Requested</div><strong id="admin-detail-amount">—</strong></div>
          <div><div class="eyebrow">Reviewer average</div><strong id="admin-detail-avg-score">—</strong></div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="section-title"><h3>Reviewer assessment</h3></div>
      <div class="card-pad">
        <div class="list" id="admin-detail-assessment">
          <div class="muted small">No assessment submitted yet.</div>
        </div>
      </div>
    </div>
    <div class="card">
      <div class="section-title"><h3>Documents</h3></div>
      <div class="card-pad list" id="admin-detail-documents-list">
        <div class="muted small">Loading documents...</div>
      </div>
    </div>
  </div>
  <aside class="card">
    <div class="section-title"><h3>Administrative actions</h3><span class="muted small">Changes are audited</span></div>
    <div class="card-pad">
      <div class="field">
        <label for="admin-grant-amount">Grant amount (INR)</label>
        <input id="admin-grant-amount" class="input" type="number" min="0" placeholder="Enter approved amount">
      </div>
      <div class="field" style="margin-top:12px">
        <label for="admin-reviewer-select">Assign reviewer</label>
        <select id="admin-reviewer-select" class="select">
          <option value="">Select a reviewer...</option>
        </select>
      </div>
      <div class="actions" style="margin-top:16px">
        <button id="admin-approve-grant-btn" class="btn btn-primary" style="flex:1" type="button">Approve grant</button>
        <button class="btn btn-danger" style="flex:1" type="button" data-modal-open="reject-modal">Reject</button>
      </div>
      <div class="actions" style="margin-top:8px">
        <button id="admin-assign-reviewer-btn" class="btn btn-secondary" style="flex:1" type="button">Assign reviewer</button>
        <button class="btn btn-ghost" style="flex:1" type="button" data-modal-open="revert-modal">Revert action</button>
      </div>
    </div>
  </aside>
</div>
<div class="modal-backdrop" id="reject-modal">
  <div class="modal" role="dialog" aria-modal="true">
    <div class="modal-head">
      <h3>Reject application</h3>
      <button class="icon-btn" data-modal-close aria-label="Close"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label for="admin-reject-reason">Reason *</label>
        <textarea id="admin-reject-reason" class="textarea" placeholder="Provide the administrative reason for rejection." required></textarea>
      </div>
      <div class="actions" style="justify-content:flex-end;margin-top:16px">
        <button class="btn btn-secondary" data-modal-close type="button">Cancel</button>
        <button id="admin-confirm-reject-btn" class="btn btn-danger" type="button">Confirm rejection</button>
      </div>
    </div>
  </div>
</div>
<div class="modal-backdrop" id="revert-modal">
  <div class="modal" role="dialog" aria-modal="true">
    <div class="modal-head">
      <h3>Revert last action</h3>
      <button class="icon-btn" data-modal-close aria-label="Close"><i data-lucide="x"></i></button>
    </div>
    <div class="modal-body">
      <p class="small">Reverting will roll back the application to its previous workflow stage.</p>
      <div class="actions" style="justify-content:flex-end;margin-top:16px">
        <button class="btn btn-secondary" data-modal-close type="button">Cancel</button>
        <button id="admin-confirm-revert-btn" class="btn btn-danger" type="button">Revert action</button>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/shell-end') %>