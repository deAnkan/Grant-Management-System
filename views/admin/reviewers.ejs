<%- include('../partials/breadcrumbs',{items:[{label:'Administration',href:'/admin/dashboard'},{label:'Reviewers'}]}) %>
<div class="page-head"><div><h1>Reviewer management</h1><p>Monitor reviewer workload and availability for application assignment.</p></div><button class="btn btn-primary" data-demo-action="Reviewer invitation functionality must be connected to a supported backend endpoint before enabling."><i data-lucide="user-plus"></i> Add reviewer</button></div>
<div class="card"><div class="filters"><input id="reviewer-search" class="input" style="max-width:320px" placeholder="Search reviewer name or email" aria-label="Search reviewers"><button id="reviewer-search-btn" class="btn btn-secondary" type="button">Search</button></div><div class="table-wrap"><table class="table"><thead><tr><th>Reviewer</th><th>Email</th><th>Employee ID</th><th>Phone</th><th>Status</th></tr></thead><tbody id="reviewers-table-body"><tr><td colspan="5" class="muted small">Loading reviewers...</td></tr></tbody></table></div></div>
<div class="drawer-backdrop"><div id="reviewer-drawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="reviewer-title"><div class="drawer-head"><h3 id="reviewer-title">Manage reviewer</h3><button class="icon-btn" data-drawer-close aria-label="Close"><i data-lucide="x"></i></button></div><div class="drawer-body"><div class="field"><label for="rstatus">Account status</label><select id="rstatus" class="select"><option>Active</option><option>Inactive</option></select></div><div class="field" style="margin-top:12px"><label for="capacity">Assignment capacity</label><input id="capacity" class="input" type="number" value="8" min="0"></div><div class="notice warning" style="margin-top:14px">Capacity is a UI field only here. Persist and enforce it in the reviewer service before using it for assignment decisions.</div><div class="actions" style="margin-top:18px"><button class="btn btn-primary" style="width:100%" data-demo-action="Reviewer update requested via PATCH /api/v1/admin/reviewers/:reviewerId">Save changes</button></div></div></div></div>
