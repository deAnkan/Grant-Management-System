<%- include('../partials/head', { title: 'Forgot password' }) %>
<div class="auth">
  <section class="auth-aside"><div><div class="brand"><div class="brand-mark">G</div><div><strong>Grant Office</strong><span>Institutional Research</span></div></div><div style="margin-top:18vh" class="auth-rule"><h1>Reset your password.</h1><p>We will email a time-limited reset link.</p></div></div></section>
  <main class="auth-main"><form id="forgot-password-form" class="auth-box"><div class="eyebrow">Account recovery</div><h1 style="margin-top:6px">Forgot password</h1><div class="field" style="margin-top:22px"><label for="forgot-email">Email</label><input id="forgot-email" type="email" class="input" autocomplete="email" required></div><div class="field" style="margin-top:14px"><label for="forgot-role">Role</label><select id="forgot-role" class="input" required><option value="faculty">Faculty</option><option value="reviewer">Reviewer</option><option value="admin">Administrator</option></select></div><button class="btn btn-primary" style="width:100%;margin-top:20px" type="submit">Send reset link</button><p class="help" style="margin-top:14px"><a href="/login">Back to sign in</a></p></form></main>
</div>
<%- include('../partials/end') %>
