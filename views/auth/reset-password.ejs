<%- include('../partials/head', { title: 'Reset password' }) %>
<div class="auth">
  <section class="auth-aside"><div><div class="brand"><div class="brand-mark">G</div><div><strong>Grant Office</strong><span>Institutional Research</span></div></div><div style="margin-top:18vh" class="auth-rule"><h1>Choose a new password.</h1><p>Your reset link is valid for 15 minutes.</p></div></div></section>
  <main class="auth-main"><form id="reset-password-form" class="auth-box"><div class="eyebrow">Account recovery</div><h1 style="margin-top:6px">Reset password</h1><div class="field" style="margin-top:22px"><label for="new-password">New password</label><input id="new-password" type="password" class="input" autocomplete="new-password" minlength="8" required></div><div class="field" style="margin-top:14px"><label for="confirm-password">Confirm password</label><input id="confirm-password" type="password" class="input" autocomplete="new-password" minlength="8" required></div><button class="btn btn-primary" style="width:100%;margin-top:20px" type="submit">Reset password</button></form></main>
</div>
<%- include('../partials/end') %>
