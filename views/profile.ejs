<%- include('partials/shell-start',{title:'Profile',navItems:[],user,institutionName:'IEM-UEM Grant Office'}) %>
<%- include('partials/breadcrumbs',{items:[{label:'Profile'}]}) %>
<div class="page-head"><div><h1>Profile</h1><p>Institutional identity and contact information.</p></div></div>
<div class="grid grid-2"><form id="profile-form" class="card" enctype="multipart/form-data"><div class="section-title"><h3>Personal information</h3></div><div class="card-pad"><div class="profile-photo"><img id="profile-image-preview" src="https://cdn-icons-png.flaticon.com/512/9131/9131529.png" alt="Profile picture"><div><strong>Profile picture</strong><p class="muted small">JPG, PNG, or JPEG. Maximum 10 MB.</p><label class="btn btn-secondary" for="profile-image">Change photo</label><input id="profile-image" type="file" accept=".jpg,.jpeg,.png" hidden></div></div><div class="form-grid" style="margin-top:20px"><div class="field"><label for="name">Full name</label><input id="name" class="input" required></div><div class="field"><label for="employee">Employee ID</label><input id="employee" class="input" disabled></div><div class="field"><label for="email">Email</label><input id="email" class="input" type="email" disabled></div><div class="field"><label for="phone">Phone</label><input id="phone" class="input" inputmode="numeric" placeholder="10-digit phone number"></div></div><div class="actions" style="justify-content:flex-end;margin-top:18px"><button type="submit" class="btn btn-primary">Save changes</button></div></div></form>
<div class="card"><div class="section-title"><h3>Account access</h3></div><div class="card-pad"><div class="list"><div class="list-item"><span>Role</span><strong>Faculty</strong></div><div class="list-item"><span>Authentication</span><strong>Email / Employee ID + OTP</strong></div><div class="list-item"><span>Last sign-in</span><strong>15 Sep 2026, 09:12</strong></div></div><div class="notice" style="margin-top:16px">Role, permissions, and identity verification are controlled by the backend. This page does not provide role escalation.</div></div></div></div>
<%- include('partials/shell-end') %>
