# Runtime
NODE_ENV=development
PORT=8000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/grant-in-aid

# Auth
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d
OTP_EXPIRY_MINUTES=5
OTP_HASH_SECRET=replace-with-a-long-random-string
BOOTSTRAP_ADMIN_SECRET=

# Public URLs
APP_BASE_URL=http://localhost:8000
ADMIN_RESET_PASSWORD_URL=http://localhost:5173/auth/superadmin/reset-password
FACULTY_RESET_PASSWORD_URL=http://localhost:5173/auth/faculty/reset-password/REAL_TOKEN
REVIEWER_RESET_PASSWORD_URL=http://localhost:5173/auth/reviewer/reset-password/REAL_TOKEN
REVIEWER_LOGIN_URL=http://localhost:5173/auth/reviewer/login

# Email: smtp (default) or resend
MAIL_PROVIDER=smtp
EMAIL_USER=
EMAIL_PASS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Deployment / operations (optional)
TRUST_PROXY=
DNS_SERVERS=
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5
